{"id":"G5299014_05","번호":5,"배점":"","몸":[["글","다음은 산 염기 반응의 화학 반응식이다."],["틀",[["글","(가) HCl(<i>aq</i>)+ H<sub>2</sub>O(<i>l</i>)→ Cl<sup>−</sup>(<i>aq</i>)+ H<sub>3</sub>O <sup>+</sup>(<i>aq</i>)"],["글","(나) CH<sub>2</sub>(NH<sub>2</sub>)COOH(<i>aq</i>)+ OH <sup>−</sup>(<i>aq</i>)→ CH<sub>2</sub>(NH<sub>2</sub>)COO <sup>−</sup>(<i>aq</i>)+ H<sub>2</sub>O(<i>l</i>)"],["글","(다) NH<sub>3</sub>(<i>aq</i>)+ H<sub>2</sub>O(<i>l</i>)→ NH<sub>4</sub><sup>+</sup>(<i>aq</i>)+ OH <sup>−</sup>(<i>aq</i>)"]]],["글","이에 대한 옳은 설명만을 &lt;보기&gt;에서 있는 대로 고른 것은?"]],"보기":[["ㄱ","(가)에서 HCl는 아레니우스 산이다."],["ㄴ","(나)에서 CH<sub>2</sub>(NH<sub>2</sub>)COOH은 브뢴스테드-로우리 산이다."],["ㄷ","(다)에서 NH<sub>3</sub>는 루이스 염기이다."]],"선지":["ㄱ","ㄷ","ㄱ, ㄴ","ㄴ, ㄷ","ㄱ, ㄴ, ㄷ"],"선지표":null,"선지그림":[null,null,null,null,null],"단폭":409.0}